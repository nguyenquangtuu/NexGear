# ==========================================
# NEXGEAR BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=nexgear_db

# MongoDB Database
MONGODB_URI=mongodb://localhost:27017/nexgear_db

# Session Configuration
SESSION_SECRET=your_session_secret_key_here
SESSION_COOKIE_NAME=nexgear.sid
SESSION_TTL_MS=86400000

# PAYOS Payment Gateway
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# SEPAY Payment Webhook
SEPAY_WEBHOOK_API_KEY=your_sepay_webhook_api_key

# Social Auth - Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Social Auth - Facebook
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# Social Auth - Zalo
ZALO_APP_ID=your_zalo_app_id
ZALO_APP_SECRET=your_zalo_app_secret
ZALO_CALLBACK_URL=http://localhost:5000/api/auth/zalo/callback

# Email SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="NexGear <your_email@gmail.com>"

# OTP Configuration
OTP_EXPIRES_MINUTES=10

# Security & Rate Limiting
BODY_LIMIT=32kb
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_REQUESTS=40
OTP_RATE_LIMIT_WINDOW_MINUTES=10
OTP_RATE_LIMIT_MAX_REQUESTS=5
LOGIN_FAILED_WINDOW_MINUTES=15
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=30

# Pusher Realtime
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=ap1

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# AI Configuration (Optional)
OPENROUTER_API_KEY=your_openrouter_api_key

# Zalo Bot (Optional)
ZALO_BOT_TOKEN=your_zalo_bot_token
ZALO_BOT_WEBHOOK_SECRET=your_zalo_bot_webhook_secret
ZALO_BOT_PUBLIC_LINK=http://zalo.me/your_bot_id
ZALO_BOT_LINK_CODE_EXPIRES_MINUTES=10
